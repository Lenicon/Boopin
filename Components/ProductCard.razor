@implements IDisposable
@inject ICartService Cart
@inject ToastService Toasts

<article class="group flex h-full flex-col overflow-hidden rounded-3xl border border-white/10 bg-plum-800/70 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-blush-300/40">
    <div class="relative aspect-square overflow-hidden bg-plum-700">
        <img src="@Product.ImageUrl"
             alt="@Product.Name"
             loading="lazy"
             class="h-full w-full object-cover transition duration-500 group-hover:scale-105 @(SoldOut ? "opacity-50 grayscale" : "")" />

        <span class="absolute left-3 top-3 rounded-full bg-plum-950/70 px-3 py-1 text-xs font-bold text-lavender-100 backdrop-blur">
            @Product.Category.ToEmoji() @Product.Category.ToDisplayName()
        </span>

        @if (SoldOut)
        {
            <span class="absolute right-3 top-3 rounded-full bg-lavender-200 px-3 py-1 text-xs font-extrabold text-plum-950">Sold out</span>
        }
        else if (Product.StockQuantity <= 5)
        {
            <span class="absolute right-3 top-3 rounded-full bg-blush-300 px-3 py-1 text-xs font-extrabold text-plum-950">Only @Product.StockQuantity left</span>
        }
        else if (Product.IsFeatured)
        {
            <span class="absolute right-3 top-3 rounded-full bg-mint-300 px-3 py-1 text-xs font-extrabold text-plum-950">★ Featured</span>
        }
    </div>

    <div class="flex grow flex-col p-5">
        <h3 class="font-display text-xl font-semibold leading-snug text-lavender-100">@Product.Name</h3>

        <div class="mt-1 flex items-center gap-2" aria-label="@RatingLabel">
            <span class="text-sm tracking-wide text-blush-300" aria-hidden="true">@Stars</span>
            <span class="text-xs font-bold text-lavender-300">@RatingText</span>
        </div>

        <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-lavender-200/90">@Product.Description</p>

        <div class="mt-auto flex items-center justify-between gap-3 pt-5">
            <span class="font-display text-2xl font-semibold text-mint-300">@Product.Price.ToMoney()</span>

            <button type="button"
                    @onclick="AddAsync"
                    disabled="@(SoldOut || AtLimit)"
                    class="rounded-full bg-blush-400 px-4 py-2 text-sm font-extrabold text-plum-950 shadow-glow transition hover:bg-blush-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-mint-300 disabled:cursor-not-allowed disabled:bg-plum-600 disabled:text-lavender-300 disabled:shadow-none">
                @ButtonLabel
            </button>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public Product Product { get; set; } = default!;

    private bool SoldOut => Product.StockQuantity <= 0;
    private bool AtLimit => !SoldOut && Cart.State.QuantityOf(Product.Id) >= Product.StockQuantity;

    private string ButtonLabel => SoldOut ? "Sold out" : AtLimit ? "All in cart" : "Add to cart";

    private string RatingText => Product.Rating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    private string RatingLabel => $"Rated {RatingText} out of 5";

    private string Stars
    {
        get
        {
            var filled = (int)Math.Round(Product.Rating, MidpointRounding.AwayFromZero);
            filled = Math.Clamp(filled, 0, 5);
            return new string('★', filled) + new string('☆', 5 - filled);
        }
    }

    protected override void OnInitialized() => Cart.OnChange += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task AddAsync()
    {
        var added = await Cart.AddAsync(Product);
        if (added)
            Toasts.Show($"{Product.Name} joined your coven!", "🦇");
        else
            Toasts.Show($"Your cart already has every {Product.Name} we have.", "👻");
    }

    public void Dispose() => Cart.OnChange -= Refresh;
}
