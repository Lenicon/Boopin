@implements IDisposable
@inject ToastService Toasts

<div class="pointer-events-none fixed inset-x-0 bottom-4 z-[70] flex flex-col items-center gap-2 px-4" aria-live="polite">
    @foreach (var toast in Toasts.Toasts)
    {
        <div @key="toast.Id"
             class="pointer-events-auto flex max-w-sm animate-toast items-center gap-3 rounded-full border border-white/10 bg-plum-950 px-5 py-3 text-sm font-bold text-lavender-100 shadow-soft">
            <span class="text-lg" aria-hidden="true">@toast.Emoji</span>
            <span>@toast.Text</span>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toasts.OnChange += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Toasts.OnChange -= Refresh;
}
