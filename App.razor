<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Lost in the graveyard · Boopin</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <section class="mx-auto max-w-xl px-6 py-24 text-center">
                <p class="text-6xl" aria-hidden="true">🦇</p>
                <h1 class="mt-4 font-display text-4xl font-semibold text-lavender-100">Nothing here but cobwebs</h1>
                <p class="mt-3 text-lavender-200">That page flew away. Let's get you back to the plushies.</p>
                <a href="/" class="mt-8 inline-block rounded-full bg-blush-400 px-6 py-3 font-bold text-plum-950 shadow-glow transition hover:bg-blush-300">Back home</a>
            </section>
        </LayoutView>
    </NotFound>
</Router>
