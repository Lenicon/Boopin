@page "/cart"
@implements IDisposable
@inject ICartService Cart
@inject NavigationManager Navigation

<PageTitle>Your Coven Cart · Boopin</PageTitle>

<div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
    <div class="flex items-center justify-between border-b border-white/10 pb-5">
        <h1 class="font-display text-3xl font-semibold text-lavender-100">
            Your coven <span class="text-lg font-normal text-lavender-300">(@Cart.State.TotalItemCount items)</span>
        </h1>
        <a href="/shop" class="text-sm font-bold text-blush-300 hover:underline">← Keep browsing</a>
    </div>

    @if (Cart.State.IsEmpty)
    {
        <div class="flex flex-col items-center justify-center gap-3 py-20 text-center">
            <p class="text-6xl" aria-hidden="true">👻</p>
            <p class="font-display text-xl text-lavender-100">It's awfully quiet in here</p>
            <p class="text-sm text-lavender-300">Your cart is empty. Adopt a plushie and it will haunt this space.</p>
            <a href="/shop"
               class="mt-3 rounded-full bg-blush-400 px-6 py-3 text-sm font-extrabold text-plum-950 shadow-glow transition hover:bg-blush-300">
                Browse shop
            </a>
        </div>
    }
    else
    {
        <div class="mt-8 grid gap-8 lg:grid-cols-3">
            <ul class="space-y-4 lg:col-span-2">
                @foreach (var item in Cart.State.Items)
                {
                    <li @key="item.Product.Id" class="flex gap-4 rounded-2xl bg-plum-800/60 p-4 border border-white/5">
                        <img src="@item.Product.ImageUrl" alt="" class="h-20 w-20 flex-none rounded-xl object-cover" />

                        <div class="flex min-w-0 flex-1 flex-col">
                            <div class="flex items-start justify-between gap-2">
                                <p class="font-display text-base font-semibold leading-snug text-lavender-100">@item.Product.Name</p>
                                <button type="button"
                                        @onclick="() => Cart.RemoveAsync(item.Product.Id)"
                                        aria-label="Remove @item.Product.Name from cart"
                                        class="flex-none rounded-full p-1 text-lavender-300 transition hover:text-blush-300">
                                    🗑️
                                </button>
                            </div>
                            <p class="text-xs text-lavender-300">@item.Product.Price.ToMoney() each</p>

                            <div class="mt-auto flex items-center justify-between pt-2">
                                <div class="flex items-center gap-1 rounded-full bg-plum-900 p-1">
                                    <button type="button"
                                            @onclick="() => Cart.DecrementAsync(item.Product.Id)"
                                            class="grid h-7 w-7 place-items-center rounded-full bg-plum-700 font-extrabold text-lavender-100 hover:bg-blush-400 hover:text-plum-950">
                                        −
                                    </button>
                                    <span class="min-w-8 text-center text-sm font-extrabold">@item.Quantity</span>
                                    <button type="button"
                                            @onclick="() => Cart.IncrementAsync(item.Product.Id)"
                                            disabled="@(item.Quantity >= item.Product.StockQuantity)"
                                            class="grid h-7 w-7 place-items-center rounded-full bg-plum-700 font-extrabold text-lavender-100 hover:bg-mint-300 hover:text-plum-950 disabled:opacity-40">
                                        +
                                    </button>
                                </div>
                                <p class="font-display text-lg font-semibold text-mint-300">@item.TotalPrice.ToMoney()</p>
                            </div>
                        </div>
                    </li>
                }
            </ul>

            <div class="h-fit space-y-4 rounded-3xl border border-white/10 bg-plum-800/80 p-6">
                <h2 class="font-display text-xl font-semibold text-lavender-100">Order summary</h2>
                <div class="flex items-center justify-between text-sm text-lavender-300">
                    <span>Shipping</span>
                    <span class="font-bold text-mint-300">Free (ghosts fly)</span>
                </div>
                <div class="flex items-end justify-between border-t border-white/10 pt-4">
                    <span class="text-lavender-200">Grand total</span>
                    <span class="font-display text-2xl font-semibold text-lavender-100">@Cart.State.GrandTotal.ToMoney()</span>
                </div>

                <button type="button"
                        @onclick="GoToCheckout"
                        class="w-full rounded-full bg-blush-400 py-3 text-base font-extrabold text-plum-950 shadow-glow transition hover:bg-blush-300">
                    Proceed to Checkout
                </button>
                <button type="button"
                        @onclick="Cart.ClearAsync"
                        class="w-full text-center text-sm font-bold text-lavender-300 underline-offset-4 hover:text-blush-300 hover:underline">
                    Clear cart
                </button>
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Cart.OnChange += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    
    private void GoToCheckout() => Navigation.NavigateTo("/checkout");

    public void Dispose() => Cart.OnChange -= Refresh;
}